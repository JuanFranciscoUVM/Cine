<%- include('partials/header') %>

<div class="stats-grid">
  <div class="stat-card">
    <div class="value">Hola, <%= user.nombre %></div>
    <div class="label">Rol: <%= user.rol %></div>
  </div>
</div>

<div class="card">
  <h2>Su panel</h2>
  <% if (user.rol === 'admin') { %>
    <p style="color: var(--text-muted); line-height: 1.6;">
      Como <strong>admin</strong> gestiona el catálogo del cine:
      <br><br>
      - Crear, editar y eliminar <a href="/peliculas" style="color:var(--primary)">películas</a><br>
      - Crear y editar <a href="/salas" style="color:var(--primary)">salas</a><br>
      - Gestionar el concesionario de <a href="/snacks" style="color:var(--primary)">snacks</a><br>
      - Consultar <a href="/funciones" style="color:var(--primary)">funciones</a>, <a href="/tickets" style="color:var(--primary)">tickets</a> y <a href="/ventas-snacks" style="color:var(--primary)">ventas de snacks</a>
    </p>
  <% } else if (user.rol === 'empleado') { %>
    <p style="color: var(--text-muted); line-height: 1.6;">
      Como <strong>empleado</strong> opera programación, boletería y concesionario:
      <br><br>
      - Programar <a href="/funciones" style="color:var(--primary)">funciones</a> y controlar <a href="/reservaciones" style="color:var(--primary)">reservaciones</a><br>
      - Emitir y gestionar <a href="/tickets" style="color:var(--primary)">tickets</a><br>
      - Registrar y controlar <a href="/ventas-snacks" style="color:var(--primary)">ventas de snacks</a><br>
      - Consultar <a href="/snacks" style="color:var(--primary)">snacks</a>, películas y salas
    </p>
  <% } else if (user.rol === 'cliente') { %>
    <p style="color: var(--text-muted); line-height: 1.6;">
      Como <strong>cliente</strong> puede reservar y comprar:
      <br><br>
      - Ver <a href="/peliculas" style="color:var(--primary)">películas</a> y <a href="/funciones" style="color:var(--primary)">funciones</a><br>
      - Crear <a href="/reservaciones" style="color:var(--primary)">reservaciones</a> y <a href="/tickets" style="color:var(--primary)">tickets</a><br>
      - Comprar en el concesionario (<a href="/snacks" style="color:var(--primary)">snacks</a> / <a href="/ventas-snacks" style="color:var(--primary)">ventas</a>)
    </p>
  <% } %>
  <p style="margin-top: 1rem; color: var(--text-muted);">
    Detalle completo en <a href="/permisos" style="color: var(--primary);">Roles y permisos</a>.
  </p>
</div>

<%- include('partials/footer') %>
